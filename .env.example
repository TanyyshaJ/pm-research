# Docker Compose only. Use URL-safe characters for the local Postgres password.
POSTGRES_PASSWORD=replace-with-a-local-development-password
# Native runtime reads environment variables from your shell.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fieldnotes
# COOKIE_SECURE=true  # only behind HTTPS
# Optional: provide a server-wide AI connection. Alternatively use Connect AI in the app.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
