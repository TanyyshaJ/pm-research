  "components": {
    "schemas": {
      "ConnectionInput": {
        "properties": {
          "api_key": {
            "type": "string",
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          },
          "model": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Model",
            "default": "gpt-5-mini"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "ConnectionInput"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProjectInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "question": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 10,
            "title": "Question"
          },
          "audience": {
            "type": "string",
            "maxLength": 200,
            "title": "Audience",
            "default": ""
          },
          "geography": {
            "type": "string",
            "maxLength": 100,
            "title": "Geography",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "question"
        ],
        "title": "ProjectInput"
      },
      "RunInput": {
        "properties": {
          "competitors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Competitors"
          },
          "customer_notes": {
            "type": "string",
            "maxLength": 15000,
            "title": "Customer Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
